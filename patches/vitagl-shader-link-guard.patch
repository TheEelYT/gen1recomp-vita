+#if defined(HAVE_SHARK_LOG) || defined(LOG_ERRORS)
+static void g1r_shader_diagnostic(const char *msg, shark_log_level level, int line) {
+	FILE *file = fopen("ux0:data/g1r-shaders.txt", "a");
+	if (file) {
+		fprintf(file, "level=%d line=%d %s\n", (int)level, line, msg);
